 "claims": [
  {
   "id": "c_depth_dark",
   "text": "Deep-water coral reefs in the Gulf of Mexico occur around 500 m depth, in perpetual darkness.",
   "sources": [
    "noaa_lophelia_bg",
    "sciam_coldwater"
   ],
   "status": "verified",
   "note": "verified via search excerpts of the cited pages (pages not readable by the fetcher); ~500 m reefs, perpetual darkness, water colder than 12 C"
  },
  {
   "id": "c_feed",
   "text": "These corals are animals that feed on particles suspended in the water (suspension feeders), not on sunlight.",
   "sources": [
    "prouty2011",
    "sciam_coldwater"
   ],
   "status": "verified",
   "note": "Prouty 2011 abstract: black corals are benthic suspension feeders"
  },
  {
   "id": "c_cruise",
   "text": "The Lophelia II 2009 expedition ran 19 August - 12 September 2009 aboard NOAA ship Ronald H. Brown.",
   "sources": [
    "noaa_lophelia09"
   ],
   "status": "verified",
   "note": "via search excerpt of the NOAA mission summary; 'most of a month' = 25 days"
  },
  {
   "id": "c_rov",
   "text": "The expedition used the ROV Jason II and collected physical samples of coral communities.",
   "sources": [
    "noaa_lophelia09"
   ],
   "status": "verified",
   "note": "via search excerpt of NOAA logs (20 dives, 17 sites; samples collected, live corals kept in tanks)"
  },
  {
   "id": "c_age",
   "text": "Radiocarbon dating shows Gulf of Mexico black corals (Leiopathes sp.) growing continuously for at least two millennia.",
   "sources": [
    "prouty2011"
   ],
   "status": "verified",
   "note": "read in the abstract: 'at least the last 2 millennia', 300 m, De Soto Slope"
  },
  {
   "id": "c_growth",
   "text": "Their radial growth is 8-22 micrometres per year, thinner than a human hair (~50-100 micrometres).",
   "sources": [
    "prouty2011"
   ],
   "status": "verified"
  },
  {
   "id": "c_spill",
   "text": "After the 2010 Deepwater Horizon spill, a deep-water coral community 11 km from the well showed widespread stress and tissue loss linked to Macondo oil.",
   "sources": [
    "white2012"
   ],
   "status": "verified",
   "note": "via the USGS abstract page: 46% of 43 corals with >50% of the colony affected"
  }
 ],
